<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>AniCraft</string>
  <key>CFBundleName</key>
  <string>AniCraft</string>
  <key>CFBundleExecutable</key>
  <string>AniCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.anicraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>AniCraftVersion</key>
  <string>@VERSION@</string>
  <key>AniCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>AniCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 ArtCraft Team and the AniCraft contributors. MIT OR Apache-2.0.</string>

  <!-- AniCraft's own format: a JSON document (crates/engine/src/format.rs). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.anicraft.document</string>
      <key>UTTypeDescription</key>
      <string>AniCraft Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>AniCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>anicraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-anicraft</string></array>
      </dict>
    </dict>
  </array>
  <!-- Formats AniCraft opens as an untitled import (ADR 0009). Imported, so the system's own
       declaration wins when another app declares them. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.anicraft.fla</string>
      <key>UTTypeDescription</key>
      <string>FLA Document</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>fla</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.anicraft.xfl</string>
      <key>UTTypeDescription</key>
      <string>XFL Document</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>xfl</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.anicraft.moho</string>
      <key>UTTypeDescription</key>
      <string>Moho Document</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>moho</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.anicraft.mohoproj</string>
      <key>UTTypeDescription</key>
      <string>Moho Project Document</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>mohoproj</string></array>
      </dict>
    </dict>
  </array>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>AniCraft Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>AniCraft</string>
      <key>LSItemContentTypes</key>
      <array><string>ai.storyteller.anicraft.document</string></array>
    </dict>
    <dict>
      <!-- Viewer: AniCraft reads these and never writes them back. -->
      <key>CFBundleTypeName</key>
      <string>Animation Document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.anicraft.fla</string>
        <string>ai.storyteller.anicraft.xfl</string>
        <string>ai.storyteller.anicraft.moho</string>
        <string>ai.storyteller.anicraft.mohoproj</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
