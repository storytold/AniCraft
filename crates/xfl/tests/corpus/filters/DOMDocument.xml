<?xml version="1.0" encoding="UTF-8"?>
<!-- AniCraft XFL corpus: filters and blend modes. One instance per filter (drop shadow, blur,
     glow, bevel, adjust colour, gradient glow, gradient bevel, a stack of two, a switched-off
     one, an unknown one) on the top row; blend modes over a striped ground on the bottom row.
     Self-authored. -->
<DOMDocument xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://ns.adobe.com/xfl/2008/" width="320" height="180" frameRate="24" backgroundColor="#F1FAEE">
  <symbols>
    <Include href="Chip.xml" loadImmediate="false"/>
  </symbols>
  <timelines>
    <DOMTimeline name="Scene 1">
      <layers>
        <DOMLayer name="Filters" color="#4F80FF">
          <frames>
            <DOMFrame index="0" keyMode="9728">
              <elements>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="30" ty="30"/></matrix><filters><DropShadowFilter blurX="4" blurY="4" distance="6" angle="45" color="#000000" alpha="0.6"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="80" ty="30"/></matrix><filters><BlurFilter blurX="8" blurY="2" quality="2"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="130" ty="30"/></matrix><filters><GlowFilter blurX="10" blurY="10" color="#E63946" strength="2"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="180" ty="30"/></matrix><filters><BevelFilter blurX="4" blurY="4" distance="4" angle="45" highlightColor="#FFFFFF" shadowColor="#000000" shadowAlpha="0.8"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="230" ty="30"/></matrix><filters><AdjustColorFilter brightness="-20" contrast="30" saturation="-100" hue="0"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="280" ty="30"/></matrix><filters><GradientGlowFilter blurX="8" blurY="8" distance="0" type="outer"><GradientEntry color="#FFFFFF" alpha="0" ratio="0"/><GradientEntry color="#457B9D" ratio="0.5"/><GradientEntry color="#1D3557" ratio="1"/></GradientGlowFilter></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="30" ty="85"/></matrix><filters><GradientBevelFilter blurX="4" blurY="4" distance="3"><GradientEntry color="#FFFFFF" ratio="0"/><GradientEntry color="#FF0000" alpha="0" ratio="0.5"/><GradientEntry color="#000000" ratio="1"/></GradientBevelFilter></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="80" ty="85"/></matrix><filters><DropShadowFilter distance="4" color="#264653" knockout="true"/><GlowFilter blurX="6" blurY="6" color="#2A9D8F" inner="true"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="130" ty="85"/></matrix><filters><BlurFilter blurX="20" blurY="20" enabled="false"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" ><matrix><Matrix tx="180" ty="85"/></matrix><filters><ConvolutionFilter matrixX="3" matrixY="3"/></filters></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" name="fading"><matrix><Matrix tx="230" ty="85"/></matrix><color><Color alphaMultiplier="0.5"/></color><filters><DropShadowFilter distance="5" alpha="0.8" hideObject="true"/></filters></DOMSymbolInstance>
              </elements>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="Blends" color="#FF4F4F">
          <frames>
            <DOMFrame index="0" keyMode="9728">
              <elements>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="multiply"><matrix><Matrix tx="25" ty="145"/></matrix></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="screen"><matrix><Matrix tx="65" ty="145"/></matrix></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="difference"><matrix><Matrix tx="105" ty="145"/></matrix></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="add"><matrix><Matrix tx="145" ty="145"/></matrix></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="subtract"><matrix><Matrix tx="185" ty="145"/></matrix></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="overlay"><matrix><Matrix tx="225" ty="145"/></matrix></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="hardlight"><matrix><Matrix tx="265" ty="145"/></matrix></DOMSymbolInstance>
                <DOMSymbolInstance libraryItemName="Chip" blendMode="invert"><matrix><Matrix tx="300" ty="145"/></matrix></DOMSymbolInstance>
              </elements>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="Ground" color="#808080">
          <frames>
            <DOMFrame index="0" keyMode="9728">
              <elements>
                <DOMShape>
                  <fills><FillStyle index="1"><SolidColor color="#1D3557"/></FillStyle><FillStyle index="2"><SolidColor color="#A8DADC"/></FillStyle></fills>
                  <edges>
                    <Edge fillStyle1="1" edges="!0 2400|6400 2400|6400 2900|0 2900|0 2400"/>
                    <Edge fillStyle1="2" edges="!0 2900|6400 2900|6400 3600|0 3600|0 2900"/>
                  </edges>
                </DOMShape>
              </elements>
            </DOMFrame>
          </frames>
        </DOMLayer>
      </layers>
    </DOMTimeline>
  </timelines>
</DOMDocument>
