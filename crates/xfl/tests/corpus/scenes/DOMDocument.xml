<?xml version="1.0" encoding="UTF-8"?>
<!-- AniCraft XFL corpus: scenes, labels and scripts. Three scenes (the last unnamed and
     empty); frame labels, a frame comment and an anchor on a labels layer; frame scripts on an
     actions layer (reported: ActionScript isn't run yet); a sun rising across scene 1.
     Self-authored. -->
<DOMDocument xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://ns.adobe.com/xfl/2008/" width="320" height="180" frameRate="12" backgroundColor="#14213D">
  <timelines>
    <DOMTimeline name="Opening">
      <layers>
        <DOMLayer name="Actions" color="#4F80FF">
          <frames>
            <DOMFrame index="0" duration="5" keyMode="9728"><elements/></DOMFrame>
            <DOMFrame index="5" keyMode="9728">
              <Actionscript>
                <script><![CDATA[stop();
// The sun is up; wait for a click.]]></script>
              </Actionscript>
              <elements/>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="Labels" color="#FF4F4F">
          <frames>
            <DOMFrame index="0" duration="3" name="intro" labelType="name" keyMode="9728"><elements/></DOMFrame>
            <DOMFrame index="3" duration="2" name="note to self" labelType="comment" keyMode="9728"><elements/></DOMFrame>
            <DOMFrame index="5" name="sunrise" labelType="anchor" keyMode="9728"><elements/></DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="Sun" color="#4FFF4F">
          <frames>
            <DOMFrame index="0" duration="5" tweenType="motion" motionTweenSnap="true" keyMode="22017">
              <elements>
                <DOMGroup>
                  <members>
                    <DOMOvalObject x="140" y="150" objectWidth="40" objectHeight="40"><fill><SolidColor color="#FCA311"/></fill></DOMOvalObject>
                  </members>
                </DOMGroup>
              </elements>
            </DOMFrame>
            <DOMFrame index="5" keyMode="9728">
              <elements>
                <DOMGroup>
                  <members>
                    <DOMOvalObject x="140" y="40" objectWidth="40" objectHeight="40"><fill><SolidColor color="#FCA311"/></fill></DOMOvalObject>
                  </members>
                </DOMGroup>
              </elements>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="Hills" color="#808080">
          <frames>
            <DOMFrame index="0" duration="6" keyMode="9728">
              <elements>
                <DOMShape>
                  <fills><FillStyle index="1"><SolidColor color="#2B4162"/></FillStyle></fills>
                  <edges><Edge fillStyle1="1" edges="!0 2800[1600 2000 3200 2800[4800 2400 6400 2800|6400 3600|0 3600|0 2800"/></edges>
                </DOMShape>
              </elements>
            </DOMFrame>
          </frames>
        </DOMLayer>
      </layers>
    </DOMTimeline>
    <DOMTimeline name="Credits">
      <layers>
        <DOMLayer name="Scripts" color="#4F80FF">
          <frames>
            <DOMFrame index="0" duration="3" name="credits" keyMode="9728"><elements/></DOMFrame>
            <DOMFrame index="3" keyMode="9728">
              <Actionscript><script><![CDATA[gotoAndPlay("Opening", "intro");]]></script></Actionscript>
              <elements/>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="Cards" color="#FF4F4F">
          <frames>
            <DOMFrame index="0" duration="2" keyMode="9728"><elements><DOMShape><fills><FillStyle index="1"><SolidColor color="#E5E5E5"/></FillStyle></fills><edges><Edge fillStyle1="1" edges="!1200 1200|5200 1200|5200 2400|1200 2400|1200 1200"/></edges></DOMShape></elements></DOMFrame>
            <DOMFrame index="2" duration="2" keyMode="9728"><elements><DOMShape><fills><FillStyle index="1"><SolidColor color="#FCA311"/></FillStyle></fills><edges><Edge fillStyle1="1" edges="!1200 1200|5200 1200|5200 2400|1200 2400|1200 1200"/></edges></DOMShape></elements></DOMFrame>
          </frames>
        </DOMLayer>
      </layers>
    </DOMTimeline>
    <DOMTimeline name="">
      <layers/>
    </DOMTimeline>
  </timelines>
</DOMDocument>
