<?xml version="1.0" encoding="UTF-8"?>
<!-- A movie clip exported for scripts as com.example.Hero (extending MovieClip), with a frame
     script that stops it on its second frame. Self-authored. -->
<DOMSymbolItem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://ns.adobe.com/xfl/2008/" name="Hero" itemID="00000000-0000-0000-0000-000000000301" linkageExportForAS="true" linkageExportInFirstFrame="true" linkageClassName="com.example.Hero" linkageBaseClass="flash.display.MovieClip">
  <timeline>
    <DOMTimeline name="Hero">
      <layers>
        <DOMLayer name="Actions" color="#4F80FF">
          <frames>
            <DOMFrame index="0" keyMode="9728"><elements/></DOMFrame>
            <DOMFrame index="1" keyMode="9728">
              <Actionscript><script><![CDATA[stop();]]></script></Actionscript>
              <elements/>
            </DOMFrame>
          </frames>
        </DOMLayer>
        <DOMLayer name="Body" color="#FF4F4F">
          <frames>
            <DOMFrame index="0" keyMode="9728"><elements><DOMOvalObject x="-20" y="-20" objectWidth="40" objectHeight="40"><fill><SolidColor color="#E76F51"/></fill></DOMOvalObject></elements></DOMFrame>
            <DOMFrame index="1" keyMode="9728"><elements><DOMOvalObject x="-20" y="-20" objectWidth="40" objectHeight="40"><fill><SolidColor color="#F4A261"/></fill></DOMOvalObject></elements></DOMFrame>
          </frames>
        </DOMLayer>
      </layers>
    </DOMTimeline>
  </timeline>
</DOMSymbolItem>
